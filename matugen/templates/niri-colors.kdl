// DymicShell matugen niri theme overrides.

layout {
    focus-ring {
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.secondary_container.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }

    border {
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.secondary_container.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }

    shadow {
        color "{{colors.shadow.default.hex_alpha|set_alpha: 0.44}}"
    }

    tab-indicator {
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.secondary_container.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }

    insert-hint {
        color "{{colors.primary.default.hex_alpha|set_alpha: 0.5}}"
    }
}

recent-windows {
    highlight {
        active-color "{{colors.primary.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
}
