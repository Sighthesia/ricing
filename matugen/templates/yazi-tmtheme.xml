<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>DymicShell</string>
    <key>settings</key>
    <array>
        <dict>
            <key>settings</key>
            <dict>
                <key>background</key>
                <string>{{colors.background.default.hex}}</string>
                <key>foreground</key>
                <string>{{colors.on_surface.default.hex}}</string>
                <key>caret</key>
                <string>{{colors.primary.default.hex}}</string>
                <key>selection</key>
                <string>{{colors.surface_variant.default.hex}}</string>
                <key>invisibles</key>
                <string>{{colors.on_surface_variant.default.hex}}</string>
                <key>lineHighlight</key>
                <string>{{colors.surface_container.default.hex}}</string>
            </dict>
        </dict>
        <dict>
            <key>name</key>
            <string>Comment</string>
            <key>scope</key>
            <string>comment</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.on_surface_variant.default.hex}}</string>
            </dict>
        </dict>
        <dict>
            <key>name</key>
            <string>String</string>
            <key>scope</key>
            <string>string</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.tertiary.default.hex}}</string>
            </dict>
        </dict>
        <dict>
            <key>name</key>
            <string>Keyword</string>
            <key>scope</key>
            <string>keyword</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.primary.default.hex}}</string>
            </dict>
        </dict>
        <dict>
            <key>name</key>
            <string>Function</string>
            <key>scope</key>
            <string>entity.name.function, support.function</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.secondary.default.hex}}</string>
            </dict>
        </dict>
        <dict>
            <key>name</key>
            <string>Variable</string>
            <key>scope</key>
            <string>variable, support.variable</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.on_surface.default.hex}}</string>
            </dict>
        </dict>
        <dict>
            <key>name</key>
            <string>Constant</string>
            <key>scope</key>
            <string>constant.numeric, constant.language</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.error.default.hex}}</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>
