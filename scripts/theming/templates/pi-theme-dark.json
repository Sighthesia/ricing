{
  "$schema": "https://pi.dev/schemas/theme.schema.json",
  "name": "afloat-dark",
  "appearance": "dark",
  "vars": {
    "text": "{{ colors.on_surface.dark.hex }}",
    "muted": "{{ colors.on_surface_variant.dark.hex }}",
    "dim": "{{ colors.outline.dark.hex | lighten: 12 }}",
    "outline": "{{ colors.outline.dark.hex }}",
    "accent": "{{ colors.primary.dark.hex }}",
    "success": "{{ colors.tertiary.dark.hex }}",
    "warning": "{{ colors.secondary.dark.hex }}",
    "error": "{{ colors.error.dark.hex | lighten: 6 }}",
    "panel": "{{ colors.surface_container_low.dark.hex }}",
    "panelHigh": "{{ colors.surface_container_high.dark.hex }}",
    "successBg": "{{ colors.tertiary_container.dark.hex | darken: 6 }}",
    "errorBg": "{{ colors.error_container.dark.hex }}",
    "searchBg": "{{ colors.tertiary_container.dark.hex | darken: 6 }}"
  },
  "colors": {
    "accent": "accent",
    "border": "outline",
    "borderAccent": "accent",
    "borderMuted": "{{ colors.outline_variant.dark.hex }}",
    "success": "success",
    "error": "error",
    "warning": "warning",
    "muted": "muted",
    "dim": "dim",
    "text": "text",
    "thinkingText": "muted",
    "scrollbarTrack": "panel",
    "scrollbarThumb": "dim",
    "selectedBg": "panelHigh",
    "searchMatchBg": "searchBg",
    "searchMatchText": "{{ colors.on_tertiary_container.dark.hex }}",
    "userMessageBg": "{{ colors.primary_container.dark.hex }}",
    "userMessageText": "{{ colors.on_primary_container.dark.hex }}",
    "customMessageBg": "{{ colors.tertiary_container.dark.hex }}",
    "customMessageText": "{{ colors.on_tertiary_container.dark.hex }}",
    "customMessageLabel": "success",
    "toolPendingBg": "panel",
    "toolSuccessBg": "successBg",
    "toolErrorBg": "errorBg",
    "toolTitle": "text",
    "toolOutput": "text",
    "mdHeading": "warning",
    "mdLink": "accent",
    "mdLinkUrl": "muted",
    "mdCode": "success",
    "mdCodeBlock": "success",
    "mdCodeBlockBorder": "outline",
    "mdQuote": "muted",
    "mdQuoteBorder": "outline",
    "mdHr": "outline",
    "mdListBullet": "accent",
    "toolDiffAdded": "success",
    "toolDiffRemoved": "error",
    "toolDiffContext": "muted",
    "syntaxComment": "muted",
    "syntaxKeyword": "accent",
    "syntaxFunction": "warning",
    "syntaxVariable": "success",
    "syntaxString": "warning",
    "syntaxNumber": "accent",
    "syntaxType": "success",
    "syntaxOperator": "muted",
    "syntaxPunctuation": "muted",
    "thinkingOff": "dim",
    "thinkingMinimal": "muted",
    "thinkingLow": "accent",
    "thinkingMedium": "warning",
    "thinkingHigh": "success",
    "thinkingXhigh": "error",
    "thinkingMax": "accent",
    "bashMode": "success"
  },
  "export": {
    "pageBg": "{{ colors.surface_container_lowest.dark.hex }}",
    "cardBg": "panel",
    "infoBg": "searchBg"
  }
}
