{
  "$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary": {"dark": "{{colors.primary.dark.hex}}", "light": "{{colors.primary.light.hex | set_lightness 24}}"},
    "secondary": {"dark": "{{colors.secondary.dark.hex}}", "light": "{{colors.secondary.light.hex | set_lightness 20}}"},
    "accent": {"dark": "{{colors.tertiary.dark.hex}}", "light": "{{colors.tertiary.light.hex | set_lightness 18}}"},
    "error": {"dark": "{{colors.error.dark.hex | set_lightness 72}}", "light": "{{colors.error.light.hex | set_lightness 24}}"},
    "warning": {"dark": "{{colors.secondary.dark.hex}}", "light": "{{colors.secondary.light.hex | set_lightness 20}}"},
    "success": {"dark": "{{colors.tertiary.dark.hex}}", "light": "{{colors.tertiary.light.hex | set_lightness 18}}"},
    "info": {"dark": "{{colors.primary.dark.hex}}", "light": "{{colors.primary.light.hex | set_lightness 24}}"},
    "text": {"dark": "{{colors.on_surface.dark.hex}}", "light": "{{colors.on_surface.light.hex}}"},
    "textMuted": {"dark": "{{colors.on_surface_variant.dark.hex}}", "light": "{{colors.on_surface_variant.light.hex | set_lightness 24}}"},
    "background": {"dark": "{{colors.surface.dark.hex}}", "light": "{{colors.surface.light.hex}}"},
    "backgroundPanel": {"dark": "{{colors.surface_container_low.dark.hex}}", "light": "{{colors.surface_container_low.light.hex}}"},
    "backgroundElement": {"dark": "{{colors.surface_container.dark.hex}}", "light": "{{colors.surface_container.light.hex}}"},
    "border": {"dark": "{{colors.outline.dark.hex}}", "light": "{{colors.outline.light.hex}}"},
    "borderActive": {"dark": "{{colors.primary.dark.hex}}", "light": "{{colors.primary.light.hex | set_lightness 24}}"},
    "borderSubtle": {"dark": "{{colors.outline_variant.dark.hex}}", "light": "{{colors.outline_variant.light.hex}}"},
    "diffAdded": {"dark": "{{colors.tertiary.dark.hex}}", "light": "{{colors.tertiary.light.hex | set_lightness 18}}"},
    "diffRemoved": {"dark": "{{colors.error.dark.hex | set_lightness 72}}", "light": "{{colors.error.light.hex | set_lightness 24}}"},
    "diffContext": {"dark": "{{colors.on_surface_variant.dark.hex}}", "light": "{{colors.on_surface_variant.light.hex | set_lightness 24}}"},
    "diffHunkHeader": {"dark": "{{colors.secondary.dark.hex}}", "light": "{{colors.secondary.light.hex | set_lightness 20}}"},
    "diffHighlightAdded": {"dark": "{{colors.tertiary.dark.hex}}", "light": "{{colors.tertiary.light.hex | set_lightness 18}}"},
    "diffHighlightRemoved": {"dark": "{{colors.error.dark.hex | set_lightness 72}}", "light": "{{colors.error.light.hex | set_lightness 24}}"},
    "diffAddedBg": {"dark": "{{colors.surface_container.dark.hex}}", "light": "{{colors.surface_container.light.hex}}"},
    "diffRemovedBg": {"dark": "{{colors.surface_container.dark.hex}}", "light": "{{colors.surface_container.light.hex}}"},
    "diffContextBg": {"dark": "{{colors.surface_container_lowest.dark.hex}}", "light": "{{colors.surface_container_lowest.light.hex}}"},
    "diffLineNumber": {"dark": "{{colors.on_surface_variant.dark.hex}}", "light": "{{colors.on_surface_variant.light.hex | set_lightness 24}}"},
    "diffAddedLineNumberBg": {"dark": "{{colors.surface_container_low.dark.hex}}", "light": "{{colors.surface_container_low.light.hex}}"},
    "diffRemovedLineNumberBg": {"dark": "{{colors.surface_container_low.dark.hex}}", "light": "{{colors.surface_container_low.light.hex}}"},
    "markdownText": {"dark": "{{colors.on_surface.dark.hex}}", "light": "{{colors.on_surface.light.hex}}"},
    "markdownHeading": {"dark": "{{colors.primary.dark.hex}}", "light": "{{colors.primary.light.hex | set_lightness 24}}"},
    "markdownLink": {"dark": "{{colors.secondary.dark.hex}}", "light": "{{colors.secondary.light.hex | set_lightness 20}}"},
    "markdownLinkText": {"dark": "{{colors.tertiary.dark.hex}}", "light": "{{colors.tertiary.light.hex | set_lightness 18}}"},
    "markdownCode": {"dark": "{{colors.tertiary.dark.hex}}", "light": "{{colors.tertiary.light.hex | set_lightness 18}}"},
    "markdownBlockQuote": {"dark": "{{colors.on_surface_variant.dark.hex}}", "light": "{{colors.on_surface_variant.light.hex | set_lightness 24}}"},
    "markdownEmph": {"dark": "{{colors.secondary.dark.hex}}", "light": "{{colors.secondary.light.hex | set_lightness 20}}"},
    "markdownStrong": {"dark": "{{colors.primary.dark.hex}}", "light": "{{colors.primary.light.hex | set_lightness 24}}"},
    "markdownHorizontalRule": {"dark": "{{colors.outline.dark.hex}}", "light": "{{colors.outline.light.hex}}"},
    "markdownListItem": {"dark": "{{colors.primary.dark.hex}}", "light": "{{colors.primary.light.hex | set_lightness 24}}"},
    "markdownListEnumeration": {"dark": "{{colors.tertiary.dark.hex}}", "light": "{{colors.tertiary.light.hex | set_lightness 18}}"},
    "markdownImage": {"dark": "{{colors.secondary.dark.hex}}", "light": "{{colors.secondary.light.hex | set_lightness 20}}"},
    "markdownImageText": {"dark": "{{colors.tertiary.dark.hex}}", "light": "{{colors.tertiary.light.hex | set_lightness 18}}"},
    "markdownCodeBlock": {"dark": "{{colors.on_surface.dark.hex}}", "light": "{{colors.on_surface.light.hex}}"},
    "syntaxComment": {"dark": "{{colors.on_surface_variant.dark.hex}}", "light": "{{colors.on_surface_variant.light.hex | set_lightness 24}}"},
    "syntaxKeyword": {"dark": "{{colors.secondary.dark.hex}}", "light": "{{colors.secondary.light.hex | set_lightness 20}}"},
    "syntaxFunction": {"dark": "{{colors.primary.dark.hex}}", "light": "{{colors.primary.light.hex | set_lightness 24}}"},
    "syntaxVariable": {"dark": "{{colors.tertiary.dark.hex}}", "light": "{{colors.tertiary.light.hex | set_lightness 18}}"},
    "syntaxString": {"dark": "{{colors.tertiary.dark.hex}}", "light": "{{colors.tertiary.light.hex | set_lightness 18}}"},
    "syntaxNumber": {"dark": "{{colors.error.dark.hex | set_lightness 72}}", "light": "{{colors.error.light.hex | set_lightness 24}}"},
    "syntaxType": {"dark": "{{colors.tertiary.dark.hex}}", "light": "{{colors.tertiary.light.hex | set_lightness 18}}"},
    "syntaxOperator": {"dark": "{{colors.secondary.dark.hex}}", "light": "{{colors.secondary.light.hex | set_lightness 20}}"},
    "syntaxPunctuation": {"dark": "{{colors.on_surface.dark.hex}}", "light": "{{colors.on_surface.light.hex}}"}
  }
}
