{
  "manifest_version": 2,
  "name": "DymicShell NetEase Lyrics Bridge",
  "version": "0.1.0",
  "description": "Capture NetEase web lyrics state and forward it to DymicShell's localhost bridge.",
  "permissions": [
    "tabs",
    "http://127.0.0.1:18765/*",
    "https://music.163.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.163.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dymicshell-netease-lyrics@sighthesia"
    }
  }
}
